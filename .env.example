# OpenAI-compatible LLM client configuration (src/market_pulse/config/settings.py)
OPENAI_API_KEY=
# Optional: leave unset to use OpenAI's default endpoint.
# Set to point at another OpenAI-compatible provider, e.g. Groq's
# OpenAI-compatible endpoint (https://api.groq.com/openai/v1) or a local
# Ollama instance (http://localhost:11434/v1).
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-oss-20b

# File-based run/competitor-run/stage-result storage root (src/market_pulse/storage/file_repository.py)
RUNS_DIR=runs

# Shared Omantel reference catalogue CSV locations (src/market_pulse/orchestration/pipeline.py)
OMANTEL_PREPAID_CSV_PATH=data/omantel/PREPAID_PRODUCT_CATALOG.csv
OMANTEL_POSTPAID_CSV_PATH=data/omantel/POSTPAID_PRODUCT_CATALOG.csv

# Real Omantel product-performance CSV used by Step 5 risk scoring
# (src/market_pulse/services/risk_analysis_service.py). Loaded fresh per
# competitor; if missing/unreadable, risk_analysis falls back to
# performance_records=[] (REVIEW_REQUIRED) for that competitor's run.
OMANTEL_PERFORMANCE_CSV_PATH=data/omantel/PRODUCT_PERFORMANCE.csv

# Step 4/5 gap-analysis and risk-scoring formula config
# (src/market_pulse/config/formula_config.py, config/risk_scoring.yaml)
FORMULA_CONFIG_PATH=config/risk_scoring.yaml

# Logging (src/market_pulse/config/logging.py)
LOG_DIR=logs
LOG_FILE=market_pulse.log
LOG_LEVEL=INFO
